generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users User[]
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  firstName    String
  lastName     String
  passwordHash String

  companyId String

  company Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
}
